{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": ["dist/**", "dev-dist/**", "coverage/**", "node_modules/**"],
  "rules": {
    "no-console": "off",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "react/react-in-jsx-scope": "off",
    "no-underscore-dangle": [
      "error",
      { "allow": ["__APP_VERSION__", "__APP_COMMIT__", "__APP_DATE__"] }
    ]
  },
  "overrides": [
    {
      "files": ["scripts/**/*.mjs"],
      "env": { "node": true, "browser": false }
    }
  ]
}
